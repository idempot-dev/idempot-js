#!/bin/sh

# Run under the Node version pinned by mise.toml. Shells with a different
# Node first in PATH break native modules (e.g. better-sqlite3 ABI) and
# produce benchmarks/coverage from the wrong runtime.
MISE_NODE_BIN="$(mise where node 2>/dev/null)/bin"
if [ -x "$MISE_NODE_BIN/node" ]; then
    PATH="$MISE_NODE_BIN:$PATH"
    export PATH
fi

# Formatting and linting for staged files.
pnpm exec lint-staged -q

# Fast unit tests: no services, a few seconds. The complete gate (coverage,
# spec, Bun, with Postgres, MySQL and Redis running) belongs to CI and to
# `pnpm verify` before a pull request, because it needs the dev containers.
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

if echo "$STAGED" | grep -vE '^docs/' | grep -qE '\.(js|ts|mjs|cjs)$|\.feature$|package\.json$|pnpm-workspace\.yaml$'; then
    npm run test:unit
fi
