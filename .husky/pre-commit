#!/bin/sh

# Run under the Node version pinned by mise.toml. Shells with a different
# Node first in PATH break native modules (e.g. better-sqlite3 ABI) and
# produce benchmarks/coverage from the wrong runtime.
MISE_NODE_BIN="$(mise where node 2>/dev/null)/bin"
if [ -x "$MISE_NODE_BIN/node" ]; then
    PATH="$MISE_NODE_BIN:$PATH"
    export PATH
fi

# Always run lint-staged (formatting and linting)
pnpm exec lint-staged -q

# Get list of staged files (Added, Changed, Modified - not deleted)
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# Run tests only when source files, tests, or relevant configs change
# Exclude docs/ directory as documentation changes don't affect runtime
if echo "$STAGED" | grep -vE '^docs/' | grep -qE '\.(js|ts|mjs|cjs)$|\.feature$|package\.json$|pnpm-workspace\.yaml$|tests/runtime/deno/deno\.json$'; then
    npm run test:verify-coverage-min
fi
